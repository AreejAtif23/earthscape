# ---------------------------------------------------------------------------
# EarthScape frontend environment
# Copy to `.env.local` and adjust. Never commit real credentials.
# ---------------------------------------------------------------------------

# Base URL for the Python backend. The dev server proxies /api to VITE_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Set to false to send real requests through VITE_API_BASE_URL.
# While this is true every service call is served from src/data fixtures.
VITE_USE_MOCK_API=true

# Request timeout in milliseconds before the client surfaces an error state.
VITE_API_TIMEOUT_MS=20000

# Product name shown in the sidebar, page titles and report headers.
VITE_APP_NAME=EarthScape

# Optional: where the Vite dev server proxies /api during local development.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
